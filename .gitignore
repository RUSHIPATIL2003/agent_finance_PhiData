# =============================================================================
# .gitignore - Multimodal RAG Chatbot (Python 3.14)
# =============================================================================
# This file prevents unnecessary, sensitive, temporary, and generated files
# from being committed to Git. Keep all source code and configuration templates
# tracked. Follows industry best practices for Python AI/ML projects.
# =============================================================================

# -----------------------------------------------------------------------------
# Python Bytecode & Cache Files
# -----------------------------------------------------------------------------
# Compiled Python files and cache directories
__pycache__/
*.py[cod]
*$py.class

# Python distribution / packaging
*.egg-info/
*.egg
dist/
build/
.wheel/
*.whl

# -----------------------------------------------------------------------------
# Virtual Environments
# -----------------------------------------------------------------------------
# Virtual environments should never be committed
venv/
env/
.env/
.env.local/
.virtualenv/
virtualenv/
pipenv/
poetry/
conda-env/
.venv/
venv314/

# -----------------------------------------------------------------------------
# Environment & Secrets (CRITICAL - Never commit secrets!)
# -----------------------------------------------------------------------------
# Actual environment files containing secrets, API keys, tokens, passwords
.env
.env.*
!.env.example
!.env.template
.env.local
.env.production
.env.staging
.env.development
*.env
*.env.local

# Specific secret files
*.key
*.pem
*.crt
*.p12
*.pfx
secrets/
credentials/
*.credentials
*.secret
*.token

# Database credentials and connection strings
database.yml
database.yaml
*.db
*.sqlite
*.sqlite3
postgresql.conf
pg_hba.conf

# -----------------------------------------------------------------------------
# IDE & Editor Files
# -----------------------------------------------------------------------------
# VS Code
.vscode/
!.vscode/settings.json.example
!.vscode/extensions.json.example
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json

# PyCharm / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Vim / Neovim
*.swp
*.swo
*~
.vim/

# Emacs
*~
\#*#
.emacs.desktop
.elisp
*.elc

# Sublime Text
*.sublime-project
*.sublime-workspace

# Jupyter / VS Code notebooks
.ipynb_checkpoints/
*.ipynb
!notebooks/*.ipynb  # Track example notebooks in notebooks/ directory

# Other editors
.project
.classpath
.settings/
*.sln
*.suo
*.user
*.userprefs

# -----------------------------------------------------------------------------
# Operating System Files
# -----------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.AppleDouble
.LSOverride
Icon?
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# -----------------------------------------------------------------------------
# Log Files
# -----------------------------------------------------------------------------
logs/
*.log
*.log.*
log/
logging/
*.out
*.err
nohup.out
uwsgi.log
gunicorn.log
celery.log
streamlit.log

# -----------------------------------------------------------------------------
# Testing Artifacts
# -----------------------------------------------------------------------------
# pytest
.pytest_cache/
.coverage
coverage.xml
.coverage.*
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/
.pytype/
.pyre/

# Test outputs
test-results/
test-output/
junit.xml
*.testlog

# -----------------------------------------------------------------------------
# Build & Package Artifacts
# -----------------------------------------------------------------------------
# Python packaging
*.egg-info/
*.egg
dist/
build/
.sdist/
*.tar.gz
*.whl

# Pip / requirements
pip-wheel-metadata/
*.whl.metadata

# Cython / compiled extensions
*.so
*.pyd
*.dll
*.dylib

# -----------------------------------------------------------------------------
# Model & Embedding Caches (Hugging Face, Sentence Transformers, etc.)
# -----------------------------------------------------------------------------
# Hugging Face cache directories
~/.cache/huggingface/
~/.cache/torch/
.cache/huggingface/
.cache/torch/
.huggingface/
.hf_cache/

# Sentence Transformers cache
~/.cache/sentence_transformers/
.cache/sentence_transformers/
.sentence_transformers/

# Embedding model cache (project-local if used)
embedding_cache/
model_cache/
models/
weights/
*.bin
*.safetensors
*.pt
*.pth
*.onnx
*.gguf

# -----------------------------------------------------------------------------
# Vector Database & Index Files
# -----------------------------------------------------------------------------
# pgvector / PostgreSQL data (local development)
pgdata/
postgresql_data/
data/postgres/
*.dump
*.sql.backup
vector_index/
*.index
*.faiss
*.ann
*.hnsw
*.ivf

# Chroma / FAISS / other vector stores (if used locally)
chroma_db/
faiss_index/
*.chroma
*.faiss

# -----------------------------------------------------------------------------
# Document Processing & Generated Files
# -----------------------------------------------------------------------------
# Extracted content from PDFs
extracted/
extracted_images/
extracted_tables/
extracted_text/
thumbnails/
previews/
ocr_output/

# Temporary document processing
tmp/
temp/
.tmp/
*.tmp
*.temp
temp_*/
tmp_*/

# Generated document chunks / processed outputs
chunks/
processed/
chunked_documents/
document_chunks/
*.chunks.json
*.chunks.pkl
*.chunks.parquet

# -----------------------------------------------------------------------------
# Large Data Files (PDFs, datasets, embeddings)
# -----------------------------------------------------------------------------
# Original large PDFs (keep small samples only)
Data/*.pdf
Data/*.PDF
data/*.pdf
data/*.PDF
*.pdf
!docs/*.pdf  # Allow small documentation PDFs

# Generated embeddings and vector files
embeddings/
*.embeddings.npy
*.embeddings.pkl
*.embeddings.parquet
vectors/
*.vectors.npy

# Datasets
datasets/
*.csv
*.tsv
*.parquet
*.jsonl
*.ndjson
!data/sample_*.csv  # Allow small sample datasets

# -----------------------------------------------------------------------------
# Streamlit Specific
# -----------------------------------------------------------------------------
# Streamlit cache and config
.streamlit/
.streamlit/config.toml
.streamlit/secrets.toml
.streamlit/credentials.toml

# Streamlit static files cache
static/
streamlit_cache/

# -----------------------------------------------------------------------------
# Application Runtime
# -----------------------------------------------------------------------------
# Runtime directories
run/
var/
var/run/
var/log/
var/cache/
var/lib/

# PID files
*.pid
*.pid.lock

# Socket files
*.sock

# -----------------------------------------------------------------------------
# Database Migrations (keep migration scripts, ignore generated)
# -----------------------------------------------------------------------------
# Alembic / SQLAlchemy migrations
migrations/versions/*.pyc
migrations/__pycache__/

# -----------------------------------------------------------------------------
# CI/CD & Deployment
# -----------------------------------------------------------------------------
# GitHub Actions / GitLab CI local cache
.github/workflows/*.bak
.gitlab/ci/*.bak

# Docker
.docker/
docker-compose.override.yml
docker-compose.local.yml
Dockerfile.local
.dockerignore.local

# Kubernetes
.kube/
kubeconfig
*.kubeconfig

# Terraform
*.tfstate
*.tfstate.*
*.tfvars
.terraform/
*.tfplan

# -----------------------------------------------------------------------------
# Profiling & Debugging
# -----------------------------------------------------------------------------
*.prof
*.profraw
.profiler/
coverage.prof
*.lprof
*.stat
py-spy/
*.speedscope.json

# -----------------------------------------------------------------------------
# Documentation Build
# -----------------------------------------------------------------------------
docs/_build/
docs/build/
docs/.build/
site/
_html/
*.html
!docs/*.md
!README.md
!CONTRIBUTING.md
!CHANGELOG.md
!LICENSE.md

# -----------------------------------------------------------------------------
# Miscellaneous
# -----------------------------------------------------------------------------
# Editor backup files
*~
*.bak
*.backup
*.orig
*.rej

# OS metadata
.AppleDesktop
Network Trash Folder
Temporary Items

# Package lock files (optional - some teams commit these)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# =============================================================================
# END OF .gitignore
# =============================================================================