# ==============================================================================
# Financial Multi-Agent Assistant Configuration
# ==============================================================================

# LLM API Keys (At least one provider required)
# ------------------------------------------------------------------------------
# Google Gemini API Key (Recommended default)
# Get your key at: https://aistudio.google.com/
GOOGLE_API_KEY="your_google_api_key_here"

# Groq API Key (Fast inference fallback/alternative)
# Get your key at: https://console.groq.com/
GROQ_API_KEY="your_groq_api_key_here"

# Phidata API Key (Optional telemetry/workspace)
# Get your key at: https://phidata.com/
PHI_API_KEY=""

# OpenAI API Key (Optional)
OPENAI_API_KEY=""

# Server Configuration
# ------------------------------------------------------------------------------
API_HOST="127.0.0.1"
API_PORT=8000

# Streamlit to Backend Connection URL
FASTAPI_BACKEND_URL="http://127.0.0.1:8000"

# Model Preferences
# Supported providers: "gemini", "groq", "openai"
DEFAULT_MODEL_PROVIDER="gemini"
DEFAULT_GEMINI_MODEL="gemini-2.5-flash"
DEFAULT_GROQ_MODEL="llama-3.3-70b-versatile"
