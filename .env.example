# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Hugging Face Configuration
HF_API_TOKEN=your_huggingface_token_here
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# LLM Configuration (OpenAI compatible)
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_NAME=model_supported_by_Groq (for eg: llama-3.3-70b-versatile)
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

# Document Processing Configuration
CHUNK_SIZE=512
CHUNK_OVERLAP=50
DOCUMENT_PATH=Data/sample.pdf

# Retrieval Configuration
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.7
ENABLE_RERANKING=false
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# Application Configuration
APP_SECRET_KEY=your_secret_key_here_change_in_production
LOG_LEVEL=INFO
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600

# Database Connection Pool
DB_POOL_MIN_CONN=2
DB_POOL_MAX_CONN=10
DB_POOL_TIMEOUT=30

# Streamlit Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0